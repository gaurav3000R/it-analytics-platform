# Application Settings
APP_NAME="IT Analytics Platform - Risk Early Warning System"
APP_VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Security
SECRET_KEY="your-super-secret-key-change-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database - Supabase PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/it_analytics"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Jira Integration (Optional)
JIRA_URL="https://your-domain.atlassian.net"
JIRA_USERNAME="your-email@example.com"
JIRA_API_TOKEN="your-jira-api-token"

# CORS Origins
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# ML Models
MODEL_PATH="./models"
MODEL_VERSION="1.0"

# Data Processing
DATA_RAW_PATH="./data/raw"
DATA_PROCESSED_PATH="./data/processed"

# Logging
LOG_LEVEL="INFO"

# Kaggle Configuration
KAGGLE_USERNAME="gaurav3000r"
