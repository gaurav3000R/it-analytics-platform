{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "echo 'No tests in frontend yet'",
    "clean": "rm -rf .next node_modules",
    "kill": "pkill -f 'next dev' && echo '✅ Frontend server stopped' || echo '✅ Frontend not running'",
    "kill:port": "lsof -ti:3000 | xargs kill -9 2>/dev/null && echo '✅ Port 3000 freed' || echo '✅ Port 3000 already free'",
    "status": "ps aux | grep 'next dev' | grep -v grep || echo 'Frontend not running'"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.23",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.1",
    "lucide-react": "^0.545.0",
    "next": "15.5.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.15.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "20.19.20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^1.8.29",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "@eslint/eslintrc": "^3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }}